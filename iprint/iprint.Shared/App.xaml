<Application
    x:Class="iprint.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:iprint">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- dark theme (Figma: black frames) -->
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AppSubtleBrush" Color="#FF9A9A9A"/>
                    <SolidColorBrush x:Key="AppPreviewBackgroundBrush" Color="#FF262626"/>
                    <SolidColorBrush x:Key="AppStripBackgroundBrush" Color="#FF353535"/>
                    <SolidColorBrush x:Key="AppBarOutlineBrush" Color="#FFFFFFFF"/>
                    <SolidColorBrush x:Key="AppTrackBrush" Color="#FF000000"/>
                </ResourceDictionary>
                <!-- light theme (Figma: white frames) -->
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppSubtleBrush" Color="#FF6B6B6B"/>
                    <SolidColorBrush x:Key="AppPreviewBackgroundBrush" Color="#FFC2C2C2"/>
                    <SolidColorBrush x:Key="AppStripBackgroundBrush" Color="#FFADA4A4"/>
                    <SolidColorBrush x:Key="AppBarOutlineBrush" Color="#FF000000"/>
                    <SolidColorBrush x:Key="AppTrackBrush" Color="#FFFFFFFF"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <x:String x:Key="AppTitle">iPRINT</x:String>

            <!-- Figma: "print photos" Semilight 96px -> 40 epx; tuned to platform list size -->
            <Style x:Key="MenuItemTextStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiLight"/>
                <Setter Property="FontSize" Value="34"/>
                <Setter Property="Margin" Value="0,4,0,10"/>
            </Style>

            <!-- Figma: "ink level" Regular 76px -> 32 epx -->
            <Style x:Key="SectionTextStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="FontSize" Value="30"/>
                <Setter Property="Margin" Value="0,18,0,10"/>
            </Style>

            <!-- Figma: "head cleaning" Semilight 65px -> 27 epx -->
            <Style x:Key="ItemTextStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiLight"/>
                <Setter Property="FontSize" Value="26"/>
                <Setter Property="Margin" Value="0,2,0,8"/>
            </Style>

            <Style x:Key="SubtleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="Foreground" Value="{ThemeResource AppSubtleBrush}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>

            <Style x:Key="SettingComboStyle" TargetType="ComboBox">
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
