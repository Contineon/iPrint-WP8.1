<Page
    x:Class="iprint.MaintenancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:iprint"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!-- Figma frames 1/2 + ink palette frames -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="19,0,0,0">
            <TextBlock x:Name="PrinterTitle" Text="{StaticResource AppTitle}" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,12,0,0"/>
            <TextBlock Text="settings" Margin="0,-6.5,0,10" Style="{ThemeResource HeaderTextBlockStyle}"
                       CharacterSpacing="{ThemeResource PivotHeaderItemCharacterSpacing}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="19,0,19,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,24">
                <ProgressBar x:Name="Progress" IsIndeterminate="True" Margin="0,0,0,6"/>
                <TextBlock x:Name="StatusText" Style="{StaticResource SubtleTextStyle}" Text="reading printer status"/>

                <TextBlock Text="ink level" Style="{StaticResource SectionTextStyle}"/>
                <StackPanel x:Name="InkPanel"/>
                <TextBlock x:Name="InkNote" Style="{StaticResource SubtleTextStyle}" Visibility="Collapsed"/>

                <StackPanel x:Name="BoxSection" Visibility="Collapsed">
                    <TextBlock Text="waste ink counters" Style="{StaticResource SectionTextStyle}"/>
                    <StackPanel x:Name="BoxPanel"/>
                </StackPanel>

                <TextBlock Text="maintenance" Style="{StaticResource SectionTextStyle}"/>
                <ListView x:Name="ActionList" IsItemClickEnabled="True" SelectionMode="None"
                          ItemClick="ActionList_ItemClick" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource ItemTextStyle}"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>

    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton x:Name="RefreshButton" Label="refresh" Icon="Refresh" Click="Refresh_Click"/>
        </CommandBar>
    </Page.BottomAppBar>
</Page>
