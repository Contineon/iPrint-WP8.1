<Page
    x:Class="iprint.PhotoPreviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:iprint"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!-- Figma frames 5/8: preview on grey, thumbnail strip, app bar clear/rotate/settings/print -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="19,0,19,8">
            <TextBlock Text="{StaticResource AppTitle}" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,12,0,0"/>
            <Grid>
                <TextBlock Text="print photos" FontSize="30" FontWeight="SemiLight"/>
                <TextBlock x:Name="CounterText" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Style="{StaticResource SubtleTextStyle}"/>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="1" Background="{ThemeResource AppPreviewBackgroundBrush}">
            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="20"/>
            <ProgressRing x:Name="PreviewBusy" IsActive="False" Width="60" Height="60"/>
            <TextBlock x:Name="EmptyText" Text="no photos selected" Style="{StaticResource ItemTextStyle}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        </Grid>

        <Grid Grid.Row="2" Background="{ThemeResource AppStripBackgroundBrush}" Height="84">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ListView x:Name="Strip" SelectionMode="Single" SelectionChanged="Strip_SelectionChanged"
                      ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                      ScrollViewer.VerticalScrollMode="Disabled">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Image Source="{Binding Thumbnail}" Width="72" Height="72" Stretch="UniformToFill" Margin="0,6,6,6"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button Grid.Column="1" Click="Add_Click" MinWidth="0" Width="72" Height="72" Margin="6,0,12,0"
                    BorderThickness="2" Padding="0">
                <SymbolIcon Symbol="Add"/>
            </Button>
        </Grid>
    </Grid>

    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton x:Name="ClearButton" Label="clear" Icon="Clear" Click="Clear_Click"/>
            <AppBarButton x:Name="RotateButton" Label="rotate" Icon="Rotate" Click="Rotate_Click"/>
            <AppBarButton Label="settings" Icon="Setting" Click="Settings_Click"/>
            <AppBarButton x:Name="PrintButton" Label="print" Click="Print_Click">
                <AppBarButton.Icon>
                    <BitmapIcon UriSource="ms-appx:///Assets/print.png"/>
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>
    </Page.BottomAppBar>
</Page>
