<Page
    x:Class="iprint.DocumentPreviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:iprint"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!-- Figma frames 9/12: document page on grey, app bar settings/print -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="19,0,19,8">
            <TextBlock Text="{StaticResource AppTitle}" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,12,0,0"/>
            <Grid>
                <TextBlock x:Name="DocTitle" Text="print documents" FontSize="30" FontWeight="SemiLight"
                           TextTrimming="CharacterEllipsis" Margin="0,0,80,0"/>
                <TextBlock x:Name="CounterText" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Style="{StaticResource SubtleTextStyle}"/>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="1" Background="{ThemeResource AppPreviewBackgroundBrush}">
            <!-- pages are laid out here (visible, scaled down) while they are rendered to bitmaps -->
            <Viewbox x:Name="RenderBox" Stretch="Uniform" Margin="20" Visibility="Collapsed">
                <Grid x:Name="RenderHost" Width="794" Height="1123" Background="White"/>
            </Viewbox>

            <FlipView x:Name="Pages" SelectionChanged="Pages_SelectionChanged" Background="Transparent">
                <FlipView.ItemTemplate>
                    <DataTemplate>
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="20"/>
                    </DataTemplate>
                </FlipView.ItemTemplate>
            </FlipView>

            <StackPanel x:Name="BusyPanel" VerticalAlignment="Bottom" Margin="19,0,19,12" Visibility="Collapsed">
                <ProgressBar IsIndeterminate="True"/>
                <TextBlock x:Name="BusyText" Style="{StaticResource SubtleTextStyle}" Text="preparing pages"/>
            </StackPanel>

            <TextBlock x:Name="EmptyText" Style="{StaticResource ItemTextStyle}" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30" Visibility="Collapsed"
                       Text="open a text document (.txt) or pictures to print"/>
        </Grid>
    </Grid>

    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton Label="open" Icon="OpenFile" Click="Open_Click"/>
            <AppBarButton Label="settings" Icon="Setting" Click="Settings_Click"/>
            <AppBarButton x:Name="PrintButton" Label="print" Click="Print_Click">
                <AppBarButton.Icon>
                    <BitmapIcon UriSource="ms-appx:///Assets/print.png"/>
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>
    </Page.BottomAppBar>
</Page>
